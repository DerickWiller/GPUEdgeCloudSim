<!--
  Quatro servidores de borda com 8 VMs de 2 núcleos e 10 000 MIPS cada, como na
  densidade de GPU (Toczé et al., 2020, Tabela 5), um por ponto de acesso, cada
  um com uma RTX 3050 atribuída à primeira VM. As câmeras ficam fixas: 4 no
  ponto de acesso 0 e 2, 1, 1 nos demais.
  Memória livre de cada GPU: 6144 − 8 × 416 = 2816 MB. Adota-se o mesmo
  valor nas três políticas: no rodízio e na escolha pelo menor tempo estimado,
  qualquer câmera pode ser atendida por qualquer GPU.
  Arquivo gerado por experimentos/gerar_configs.py.
-->
<edge_devices>

	<datacenter arch="x86" os="Linux" vmm="Xen">
		<costPerBw>0.1</costPerBw>
		<costPerSec>3.0</costPerSec>
		<costPerMem>0.05</costPerMem>
		<costPerStorage>0.1</costPerStorage>
		<location>
			<x_pos>200</x_pos>
			<y_pos>0</y_pos>
			<wlan_id>0</wlan_id>
			<attractiveness>2</attractiveness>
		</location>
		<hosts>
			<host>
				<core>16</core>
				<mips>0</mips>
				<ram>65536</ram>
				<storage>2000000</storage>
				<gpus>
					<gpu>
						<type>NVIDIA_RTX_3050</type>
						<cudaCores>2048</cudaCores>
						<!-- Capacidade em MI/s: 91 MI / 4 ms. -->
						<gflops>22750</gflops>
						<!-- Memória livre para quadros, em MB: 6144 − N × 416. -->
						<memory>2816</memory>
						<!-- Banda de memória, em GB/s; não entra no cálculo do tempo de execução. -->
						<bandwidth>224</bandwidth>
					</gpu>
				</gpus>
